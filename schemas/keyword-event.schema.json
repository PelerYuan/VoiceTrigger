{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoiceTrigger keyword event v1",
  "type": "object",
  "required": ["schema_version", "type", "id", "detected_at", "audio_end_at", "keywords", "text", "audio_seconds", "recognition_seconds"],
  "properties": {
    "schema_version": {"const": 1},
    "type": {"const": "keyword_detected"},
    "id": {"type": "string", "format": "uuid"},
    "detected_at": {"type": "string", "format": "date-time"},
    "audio_end_at": {"type": "string", "format": "date-time"},
    "keywords": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "text": {"type": "string", "minLength": 1},
    "audio_seconds": {"type": "number", "minimum": 0},
    "recognition_seconds": {"type": "number", "minimum": 0}
  },
  "additionalProperties": true
}
